# ============================================================
# Configuração do BookStack — copie este arquivo para .env
# e preencha com os valores reais. NÃO comite o .env.
# ============================================================

# URL pública pela qual o BookStack será acessado
APP_URL=http://localhost:6875

# Chave de criptografia da aplicação (NÃO altere depois de gerar dados)
# Gere uma nova com:
# docker run --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:latest appkey
APP_KEY=base64:COLE_SUA_CHAVE_AQUI=

# ------------------------------------------------------------
# Banco de dados MySQL/MariaDB
# ------------------------------------------------------------
# DB_HOST:
#   - MySQL no host Windows nativo               -> host.docker.internal
#   - MySQL via docker-compose.mysql.yml local   -> host.docker.internal (porta 3307)
#   - MySQL em outra máquina/servidor            -> IP ou hostname dela
DB_HOST=host.docker.internal
DB_PORT=3307
DB_DATABASE=bookstackapp
DB_USERNAME=bookstack
DB_PASSWORD=troque-esta-senha

# ------------------------------------------------------------
# Autenticação LDAP / Active Directory
# ------------------------------------------------------------
# Troque para "ldap" para ativar autenticação LDAP/AD.
# Mantenha "standard" para login local por e-mail/senha.
AUTH_METHOD=standard

# Host do servidor LDAP (IP, hostname, ou URI completa)
# Ex.: 10.0.0.10, ldap://srv.empresa.local, ldaps://srv.empresa.local:636
LDAP_SERVER=

# Base DN onde os usuários serão pesquisados
LDAP_BASE_DN=

# Conta de serviço usada para fazer a busca no LDAP (bind user).
# Em AD pode ser UPN (user@dominio) ou DN completo. Não pode ser anônimo no AD.
LDAP_DN=
LDAP_PASS=

# Defaults para Active Directory já estão no docker-compose.yml.
# Só descomente e ajuste se precisar mudar:
#
# LDAP_USER_FILTER=(&(objectClass=user)(|(sAMAccountName={user})(userPrincipalName={user})))
# LDAP_ID_ATTRIBUTE=sAMAccountName
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
# LDAP_THUMBNAIL_ATTRIBUTE=thumbnailPhoto
# LDAP_START_TLS=false
# LDAP_TLS_INSECURE=false
# LDAP_FOLLOW_REFERRALS=false

# ------------------------------------------------------------
# Envio de e-mail (Office 365 Direct Send — sem autenticação)
# ------------------------------------------------------------
# Não requer credenciais nem App Password. Limitação: só envia para
# usuários do MESMO tenant do Office 365.
#
# MAIL_HOST é o MX do seu domínio. Consulte com:
#   nslookup -type=MX seu-dominio.com
# O formato é: <dominio-com-tracos-no-lugar-dos-pontos>.mail.protection.outlook.com
MAIL_DRIVER=smtp
MAIL_HOST=seu-dominio-com-tracos.mail.protection.outlook.com
MAIL_PORT=25
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# Remetente exibido como "De:" (precisa ser um endereço do tenant)
MAIL_FROM=bookstack@empresa.local
MAIL_FROM_NAME=BookStack

# Validar certificado TLS do servidor
MAIL_VERIFY_SSL=true
